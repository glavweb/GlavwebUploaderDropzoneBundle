<div style="display: none" class="js-upload-preview-template-wrapper">
    <div class="js-dropzone-file gwu-card">
        <div class="gwu-card-media">
            <img data-gwu-thumbnail alt="">
            <div class="gwu-card-actions">
                <div class="gwu-progressbar">
                    <div class="gwu-progressbar-indicator" data-gwu-progress></div>
                    <div class="gwu-progressbar-text">{{ 'download_file_loading'|trans }}</div>
                </div>

                <button type="button" class="gwu-btn gwu-btn-overlay js-control-bar-edit-image gwu-is-hidden">
                    <span class="gwu-icon gwu-icon-pencil"></span>
                    {{ 'dropzone_preview_edit'|trans }}
                </button>

                <button type="button" data-gwu-remove class="gwu-btn gwu-btn-overlay">
                    <span class="gwu-icon gwu-icon-times"></span>
                    <span data-gwu-remove-label></span>
                </button>

                <div class="gwu-error-message">
                    <strong data-gwu-error></strong>
                </div>
            </div>
        </div>
    </div>
</div>
