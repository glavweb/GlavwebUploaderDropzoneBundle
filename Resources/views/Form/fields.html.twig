{% block cms_media_video_widget %}
    {% set media = value is not empty ? value : {} %}

    <div id="js-video-form-type-{{ id }}">
        <div class="gwu-input-group">
            <input type="text" class="js-upload-input gwu-control" placeholder="{{ 'download_video_placeholder'|trans }}">
            <div class="gwu-input-group-btn">
                <button type="button" class="js-control-bar-upload-video gwu-btn gwu-btn-secondary">
                    {{ 'download_video_button'|trans }}
                </button>
            </div>
        </div>

        <div class="gwu-preview-wrapper-wr">
            <div class="js-preview-wrapper"></div>

            <div class="js-preview-template" style="display: none">
                <div class="js-preview gwu-card">
                    <div class="gwu-card-media gwu-card-media-video">
                        <img src="" class="js-preview-image" alt="">
                        <div class="gwu-card-actions">
                            <button type="button" class="gwu-btn gwu-btn-overlay js-control-bar-edit">
                                <span class="gwu-icon gwu-icon-pencil"></span>
                                {{ 'video_edit'|trans }}
                            </button>
                            <button type="button" class="gwu-btn gwu-btn-overlay js-control-bar-delete">
                                <span class="gwu-icon gwu-icon-times"></span>
                                {{ 'video_remove'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% include '@GlavwebUploaderDropzone/Form/splash-screen-content-template.html.twig' %}

        <input type="hidden" id="{{ id }}" name="{{ full_name }}"
               value='{{ mediaData|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}' class="js-field-value gwu-control"/>
    </div>

    <script>
        Gwu.mount(document.getElementById('js-video-form-type-{{ id }}'), {{ {
            type: 'video',
            requestId: requestId,
            uploadUrl: uploadUrl,
            deleteUrl: deleteUrl,
            editUrl: editUrl,
            media: media,
            maxFilesize: maxFilesize,
            width: width,
            height: height,
            acceptedFiles: acceptedFiles,
            chunking: chunkingOptions,
            nameFieldState: nameFieldState,
            descriptionFieldState: descriptionFieldState,
            saveButtonLoadingText: 'splash_screen_save_button_loading'|trans,
            messages: {
                uploadVideoLoadingText: 'download_video_button_loading'|trans
            }
        }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }});
    </script>
{% endblock %}

