{% block media_file_widget %}
    {% set file = value is not empty ? value : {} %}
    {% set dropzoneDictionary = {
            dictMaxFilesExceeded : 'uploader_dict_max_files_exceeded' | trans,
            dictInvalidFileType : 'uploader_dict_invalid_file_type' | trans,
            dictFileTooBig : 'uploader_dict_file_too_big' | trans,
            dictRemoveFile : 'uploader_dict_remove_file' | trans,
            dictCancelUpload : 'uploader_dict_cancel_upload' | trans,
            dictCancelUploadConfirmation : 'uploader_dict_cancel_upload_confirmation' | trans,
            dictResponseError : 'uploader_dict_response_error' | trans,
            dictInvalidImageDimension : 'uploader_dict_invalid_image_dimension' | trans
        }
    %}

    <div id="js-file-form-type-{{ id }}" class="js-file-form-type gwu-form-control">
        <div class="js-upload-file-wrapper gwu-dropzone gwu-dropzone-file">
            <span class="gwu-dropzone-icon" aria-hidden="true"></span>
            <span class="js-control-bar-upload-file gwu-dropzone-label">{{ 'download_file_button'|trans }}</span>
        </div>

        <div class="js-preview-wrapper" id="js-preview-wrapper-{{ requestId }}"></div>

        <div style="display: none" class="js-preview-template-wrapper">
            <div class="js-dropzone-file gwu-file-row">
                <span class="js-file-name gwu-file-row-name"></span>
                <div class="gwu-progressbar">
                    <div class="gwu-progressbar-indicator" data-gwu-progress></div>
                    <div class="gwu-progressbar-text">{{ 'download_file_loading'|trans }}</div>
                </div>
                <div class="gwu-file-row-actions">
                    <button type="button" class="gwu-btn gwu-btn-quiet js-control-bar-edit-file gwu-is-hidden">
                        <span class="gwu-icon gwu-icon-pencil"></span>
                        {{ 'dropzone_preview_edit'|trans }}
                    </button>
                    <button type="button" data-gwu-remove class="gwu-btn gwu-btn-quiet">
                        <span class="gwu-icon gwu-icon-times"></span>
                        <span data-gwu-remove-label></span>
                    </button>
                </div>
                <div class="gwu-error-message">
                    <strong data-gwu-error></strong>
                </div>
            </div>
        </div>

        <div class="js-splash-screen-file-template" style="display:none;">
            <div class="js-splash-screen-content gwu-editor gwu-editor-simple">
                <div class="gwu-editor-form">
                    <div class="gwu-form-group" data-form-name-group>
                        <label class="gwu-control-label">{{ 'splash_screen_name'|trans }}</label>
                        <input data-form-name-input class="gwu-control" type="text" name="name" value="">
                        <div data-form-name-text class="gwu-text"></div>
                    </div>

                    <div class="gwu-form-group" data-form-description-group>
                        <label class="gwu-control-label">{{ 'splash_screen_description'|trans }}</label>
                        <textarea data-form-description-input class="gwu-textarea" name="description" rows="4"></textarea>
                        <div data-form-description-text class="gwu-text"></div>
                    </div>

                    <dl class="gwu-meta">
                        <div class="gwu-meta-row">
                            <dt>{{ 'splash_screen_media_type'|trans }}</dt>
                            <dd data-table-content-type></dd>
                        </div>
                        <div class="gwu-meta-row">
                            <dt>{{ 'splash_screen_media_size'|trans }}</dt>
                            <dd data-table-content-size></dd>
                        </div>
                    </dl>

                    <button data-save-button type="button" class="gwu-btn gwu-btn-success">{{ 'splash_screen_save_button'|trans }}</button>
                </div>
            </div>
        </div>

        <input type="hidden" id="{{ id }}" name="{{ full_name }}"
               value='{{ mediaData|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}' class="js-field-value gwu-control" />
    </div>

    <script>
        Gwu.mount(document.getElementById('js-file-form-type-{{ id }}'), {{ {
            type: 'file',
            requestId: requestId,
            uploadUrl: uploadUrl,
            deleteUrl: deleteUrl,
            editUrl: editUrl,
            file: file,
            maxFilesize: maxFilesize,
            width: width,
            height: height,
            acceptedFiles: acceptedFiles,
            chunking: chunkingOptions,
            nameFieldState: nameFieldState,
            descriptionFieldState: descriptionFieldState,
            saveButtonLoadingText: 'splash_screen_save_button_loading'|trans,
            messages: dropzoneDictionary
        }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }});
    </script>
{% endblock %}
